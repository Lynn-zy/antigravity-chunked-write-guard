{
  "chunked-write-guard": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/write-guard-hook.mjs post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/write-guard-hook.mjs pre-invocation",
        "timeout": 5
      }
    ]
  }
}
